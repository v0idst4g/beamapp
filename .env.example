# ---------------------------------------------------------------------------
# Beam — environment variables
# Copy this file to `.env.local` for local development, and set the same
# variables in your Vercel project dashboard for deployment.
# Never commit your real .env.local — it is gitignored.
# ---------------------------------------------------------------------------

# --- Site -------------------------------------------------------------------
# The canonical base URL of the deployment. Used for Stripe redirect URLs and
# auth email redirects. Locally: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase ---------------------------------------------------------------
# From your Supabase project: Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Service role key — SERVER ONLY. Used by the Stripe webhook to update
# subscription status. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Anthropic (the Beam AI assistant) -------------------------------------
# SERVER ONLY. Used exclusively by /api/chat. Never exposed client-side.
ANTHROPIC_API_KEY=sk-ant-...
# Optional — defaults to claude-sonnet-4-6 if unset.
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Stripe -----------------------------------------------------------------
# Secret key from the Stripe dashboard (Developers → API keys)
STRIPE_SECRET_KEY=sk_test_...
# Price IDs for the two plans (Products → your product → pricing)
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_YEARLY=price_...
# Webhook signing secret (Developers → Webhooks → your endpoint → signing secret)
STRIPE_WEBHOOK_SECRET=whsec_...
